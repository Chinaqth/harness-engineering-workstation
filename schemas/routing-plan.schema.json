{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Routing Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "selections", "approvals", "conflicts"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["routed", "needs_input", "needs_approval", "unroutable"] },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "version", "route_id", "capability_ids", "workflows", "skills", "tools", "evaluators", "reason"],
        "properties": {
          "domain_id": { "type": "string" },
          "version": { "type": "string" },
          "route_id": { "type": "string" },
          "capability_ids": { "type": "array", "items": { "type": "string" } },
          "workflows": { "type": "array", "items": { "type": "string" } },
          "skills": { "type": "array", "items": { "type": "string" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "evaluators": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approvals": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } }
  }
}
